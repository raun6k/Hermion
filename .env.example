# Copy to .env and fill in. Names only here; never commit real values.

# Database (local dev: Postgres from docker compose)
DATABASE_URL=postgresql+asyncpg://hermion:hermion@localhost:5432/hermion
TEST_DATABASE_URL=postgresql+asyncpg://hermion:hermion@localhost:5432/hermion_test

# LLM via OpenRouter (docs/engine.md#llm-provider)
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_FALLBACK_MODELS=
# true = scripted fake LLM, no network (tests, offline dev)
USE_FAKE_LLM=false

# Sarvam speech (docs/voice.md)
SARVAM_API_KEY=
# TTS voice per language: comma-separated language=persona_id (Bulbul v4 IDs, voice_language_style).
# e.g. hi-IN=aparna_hi_customer,te-IN=<persona>,en-IN=<persona>. Add an entry for any Sarvam-supported
# language; a language without one uses Sarvam's default voice.
SARVAM_TTS_SPEAKERS=hi-IN=aparna_hi_customer,te-IN=pooja_te_conversation,en-IN=simran_en_sales,ta-IN=aravind_ta_ads,kn-IN=chaitra_kn_conversation,mr-IN=ishita_mr_conversational,gu-IN=pooja_gu_customer,pa-IN=anand_pa_customer,bn-IN=roopa_bn_conversational
# Speaking rate for every voice, 0.5-2.0 (1.0 = normal; lower = slower)
SARVAM_TTS_PACE=0.9
# Quiet time (ms) after the customer stops talking before Hermion answers; shorter pauses stay one turn
VOICE_ENDPOINT_MS=1600
# true = fake STT/TTS, no network
USE_FAKE_SPEECH=false

# Frontend (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# true = frontend replays frontend/mocks instead of calling the backend
NEXT_PUBLIC_USE_MOCKS=false
