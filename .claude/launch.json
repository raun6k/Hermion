{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-mocks",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && NEXT_PUBLIC_USE_MOCKS=true NEXT_DIST_DIR=.next-mocks pnpm dev --port 3102"
      ],
      "port": 3102
    }
  ]
}
